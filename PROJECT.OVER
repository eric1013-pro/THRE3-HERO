<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>AETHER CHESS 3D v3.0 — visionOS Edition</title>
  <style>
    :root {
      /* Apple visionOS Glass Tokens */
      --glass-surface: rgba(24, 30, 46, 0.52);
      --glass-elevated: rgba(34, 42, 64, 0.66);
      --glass-heavy: rgba(14, 18, 30, 0.84);
      --glass-border: rgba(255, 255, 255, 0.22);
      --glass-specular: rgba(255, 255, 255, 0.42);
      --apple-blue: #0a84ff;
      --apple-cyan: #5ac8fa;
      --apple-gold: #ffd60a;
      --apple-green: #30d158;
      --apple-red: #ff453a;
      --apple-purple: #bf5af2;
      --text-primary: #ffffff;
      --text-secondary: rgba(235, 235, 245, 0.68);
      --text-tertiary: rgba(235, 235, 245, 0.45);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Pretendard', sans-serif;
      letter-spacing: -0.015em;
    }

    html, body {
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      background: linear-gradient(180deg, #0b192c 0%, #1e3a5f 55%, #091322 100%);
      color: var(--text-primary);
      transition: background 1.2s ease;
    }

    body.weather-DAY {
      background: linear-gradient(180deg, #0f2942 0%, #1d4e78 52%, #0c1b2e 100%);
    }
    body.weather-SUNSET {
      background: linear-gradient(180deg, #2b1331 0%, #7c2d42 48%, #1f1124 100%);
    }
    body.weather-NIGHT {
      background: linear-gradient(180deg, #040814 0%, #0d1b38 50%, #050811 100%);
    }

    #canvas-container {
      position: fixed;
      inset: 0;
      z-index: 1;
    }

    #overlay-layer {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 5;
      overflow: hidden;
    }

    /* Apple visionOS Glass Material */
    .vision-glass {
      background: var(--glass-surface);
      backdrop-filter: blur(34px) saturate(210%);
      -webkit-backdrop-filter: blur(34px) saturate(210%);
      border: 1px solid var(--glass-border);
      box-shadow:
        0 20px 48px rgba(0, 0, 0, 0.42),
        inset 0 1px 0.5px var(--glass-specular);
      border-radius: 26px;
    }

    .vision-pill {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow: inset 0 1px 0.5px rgba(255, 255, 255, 0.35);
      color: var(--text-primary);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .vision-pill:hover:not(:disabled) {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-1px);
    }
    .vision-pill:active:not(:disabled) {
      transform: scale(0.95);
    }
    .vision-pill.primary {
      background: linear-gradient(135deg, rgba(10, 132, 255, 0.85), rgba(90, 200, 250, 0.75));
      border-color: rgba(255, 255, 255, 0.45);
      box-shadow: 0 8px 24px rgba(10, 132, 255, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.5);
    }
    .vision-pill.gold {
      background: linear-gradient(135deg, rgba(255, 214, 10, 0.32), rgba(255, 159, 10, 0.42));
      border-color: rgba(255, 214, 10, 0.65);
      color: #fff3b0;
    }

    /* 차원 워프 터널 */
    #warp-tunnel {
      position: fixed;
      inset: 0;
      z-index: 28;
      pointer-events: none;
      opacity: 0;
      background: radial-gradient(circle at 50% 50%, transparent 12%, rgba(90, 200, 250, 0.38) 62%, rgba(10, 132, 255, 0.85) 100%);
      transition: opacity 0.28s ease;
    }
    #warp-tunnel.active {
      opacity: 1;
      animation: warpZoom 0.35s infinite alternate;
    }
    @keyframes warpZoom {
      from { transform: scale(1); }
      to { transform: scale(1.1); }
    }

    /* 필살기 시네마틱 레터박스 */
    #cinematic-bars {
      position: fixed;
      inset: 0;
      z-index: 22;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      opacity: 0;
      transition: opacity 0.22s ease;
      box-shadow: inset 0 0 80px rgba(10, 132, 255, 0.45);
    }
    #cinematic-bars.active { opacity: 1; }
    .letterbox {
      width: 100%;
      height: 0px;
      background: rgba(4, 7, 15, 0.9);
      backdrop-filter: blur(12px);
      transition: height 0.26s cubic-bezier(0.22, 1, 0.36, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    #cinematic-bars.active .letterbox { height: 54px; }
    .cinematic-caption {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--apple-gold);
    }

    /* ================= 1. 메인 화면 (프로필 + 3D 최애 영웅 쇼케이스) ================= */
    #title-screen {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      z-index: 30;
      padding: env(safe-area-inset-top, 12px) 14px env(safe-area-inset-bottom, 16px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
      transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #title-screen.hidden {
      opacity: 0;
      transform: translateX(-50%) scale(1.12);
      pointer-events: none !important;
    }
    #title-screen > * { pointer-events: auto; }
    #title-screen.hidden > * { pointer-events: none; }

    /* 상단 플레이어 프로필 카드 (Apple ID 스타일) */
    .profile-widget {
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .profile-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .profile-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .avatar-ring {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0a84ff, #5e5ce6);
      border: 2px solid rgba(255, 255, 255, 0.65);
      box-shadow: 0 6px 18px rgba(10, 132, 255, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 900;
      position: relative;
    }
    .lv-badge {
      position: absolute;
      bottom: -4px;
      right: -4px;
      background: var(--apple-gold);
      color: #000;
      font-size: 9.5px;
      font-weight: 900;
      padding: 1px 5px;
      border-radius: 999px;
      border: 1.5px solid #000;
    }
    .commander-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .commander-name-input {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 16px;
      font-weight: 800;
      outline: none;
      width: 155px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.25);
      padding-bottom: 1px;
    }
    .commander-tier {
      font-size: 11px;
      color: var(--apple-cyan);
      font-weight: 700;
    }
    .profile-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      background: rgba(0, 0, 0, 0.22);
      padding: 9px 12px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .p-stat {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .p-stat-label { font-size: 10px; color: var(--text-secondary); }
    .p-stat-val { font-size: 13px; font-weight: 800; margin-top: 1px; }

    /* 중앙 3D 최애 영웅 플로팅 태그 (3D 캐릭터를 가리지 않도록 우측/하단 정렬) */
    .fav-hero-floating {
      align-self: center;
      margin-top: auto;
      margin-bottom: 12px;
      padding: 8px 16px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    /* 메인 하단 런처 독 */
    .title-bottom-dock {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .brand-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .brand-logo {
      font-size: 24px;
      font-weight: 900;
      background: linear-gradient(135deg, #fff 0%, #bae6fd 60%, #c7d2fe 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .news-pill-bar {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 16px;
      padding: 10px 13px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .news-pill-bar:hover { background: rgba(255, 255, 255, 0.13); }
    .warp-btn {
      width: 100%;
      padding: 15px;
      border-radius: 18px;
      font-size: 15.5px;
      font-weight: 900;
      letter-spacing: 0.4px;
    }
    .title-nav-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    /* ================= 2. 3D 인터랙티브 영웅 도감 (3D STUDIO CODEX) ================= */
    #codex-screen {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      z-index: 35;
      padding: env(safe-area-inset-top, 12px) 14px env(safe-area-inset-bottom, 14px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    #codex-screen.visible { opacity: 1; }
    #codex-screen.visible > * { pointer-events: auto; }

    .codex-top-bar {
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* 3D 캐릭터 좌우 넘기기 플로팅 화살표 */
    .codex-stage-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 6px;
      margin: auto 0;
      pointer-events: none;
    }
    .arrow-circle {
      pointer-events: auto;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      font-size: 18px;
      font-weight: 900;
    }
    .rotate-hint {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-secondary);
      background: rgba(0, 0, 0, 0.35);
      padding: 5px 12px;
      border-radius: 999px;
      backdrop-filter: blur(8px);
    }

    /* 도감 하단 정보 카드 */
    .codex-info-sheet {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 11px;
      max-height: 52dvh;
      overflow-y: auto;
    }
    .hero-carousel-pills {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .h-pill {
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 800;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-secondary);
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .h-pill.active {
      background: var(--apple-blue);
      border-color: #fff;
      color: #fff;
      box-shadow: 0 4px 12px rgba(10, 132, 255, 0.4);
    }

    .codex-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }
    .c-stat-box {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 7px;
      text-align: center;
    }
    .c-skill-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .c-skill-item {
      padding: 9px 12px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* ================= 3. 인게임 세로 화면 (슬림 상단 캡슐 + 접이식 하단 드로어) ================= */
    #mobile-shell {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      z-index: 10;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: env(safe-area-inset-top, 10px) 12px env(safe-area-inset-bottom, 12px);
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    #mobile-shell.visible { opacity: 1; }
    .interactive { pointer-events: auto; }

    /* 상단 Apple Dynamic Island 스타일 캡슐 */
    .top-capsule-wrap {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .dynamic-capsule {
      padding: 9px 13px;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .dc-row-1 {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .dc-left {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .dc-right {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .mini-icon-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #fff;
      border-radius: 999px;
      padding: 5px 9px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }
    .mini-icon-btn:active { transform: scale(0.92); }

    .dc-scoreboard {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 0, 0, 0.26);
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .team-pips-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 800;
    }
    .pips { display: flex; gap: 5px; }
    .pip {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .pip.ally-on { background: var(--apple-cyan); box-shadow: 0 0 10px var(--apple-cyan); border-color: #fff; }
    .pip.enemy-on { background: var(--apple-red); box-shadow: 0 0 10px var(--apple-red); border-color: #fff; }

    /* 서브 바: 스테이지 & 시너지 알약 */
    .sub-pills-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 6px;
    }
    .stage-strip {
      display: flex;
      gap: 4px;
      padding: 4px 8px;
      border-radius: 999px;
    }
    .st-pill {
      padding: 3px 7px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 800;
      color: var(--text-secondary);
      cursor: pointer;
    }
    .st-pill.active { background: var(--apple-blue); color: #fff; }
    .st-pill.cleared { color: var(--apple-green); }

    .synergy-strip {
      display: flex;
      gap: 4px;
      padding: 4px 9px;
      border-radius: 999px;
      overflow-x: auto;
    }
    .syn-item {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-secondary);
      white-space: nowrap;
      padding: 2px 6px;
      border-radius: 999px;
    }
    .syn-item.active {
      background: rgba(255, 214, 10, 0.22);
      color: var(--apple-gold);
      border: 1px solid rgba(255, 214, 10, 0.5);
    }

    /* ================= 하단 컨트롤 & 아래로 말려들어가는(Collapsible) 드로어 ================= */
    .bottom-hud-area {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* 1) 항상 떠 있는 슬림 스킬 & 액션 바 (전장을 가리지 않음) */
    .compact-action-bar {
      padding: 10px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    /* 영웅 선택 창 접기/펼치기 토글 버튼 */
    .drawer-toggle-btn {
      padding: 9px 13px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: all 0.22s ease;
    }
    .drawer-toggle-btn.open {
      background: rgba(90, 200, 250, 0.22);
      border-color: var(--apple-cyan);
    }

    /* 배치된 영웅 전용 1회 특수능력 원형 퀵 버튼 리스트 */
    .quick-skill-orbs {
      display: flex;
      gap: 7px;
      align-items: center;
      overflow-x: auto;
      padding: 2px 4px;
      flex: 1;
      justify-content: center;
    }
    .skill-orb {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(255, 214, 10, 0.38), rgba(20, 25, 40, 0.9));
      border: 2px solid var(--apple-gold);
      box-shadow: 0 4px 14px rgba(255, 214, 10, 0.32);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      flex-shrink: 0;
    }
    .skill-orb:hover:not(.used) { transform: translateY(-3px) scale(1.06); }
    .skill-orb:active:not(.used) { transform: scale(0.92); }
    .skill-orb.used {
      opacity: 0.32;
      filter: grayscale(1);
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: none;
      cursor: not-allowed;
    }
    .orb-name { font-size: 9.5px; font-weight: 900; line-height: 1.1; }
    .orb-star { font-size: 8px; color: var(--apple-gold); font-weight: 900; }

    .fight-pill-btn {
      padding: 11px 18px;
      border-radius: 16px;
      background: linear-gradient(135deg, #0a84ff, #5e5ce6);
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: #fff;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(10, 132, 255, 0.4);
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .fight-pill-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* 2) 아래로 스르륵 말려 들어가는 영웅 선택 드로어 (Roll-down Drawer) */
    .roster-drawer {
      padding: 14px;
      overflow: hidden;
      max-height: 260px;
      opacity: 1;
      transform: translateY(0) scaleY(1);
      transform-origin: bottom center;
      transition:
        max-height 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.28s ease,
        transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        padding 0.35s ease,
        margin 0.35s ease,
        border-width 0.3s ease;
    }
    .roster-drawer.collapsed {
      max-height: 0px;
      opacity: 0;
      padding-top: 0;
      padding-bottom: 0;
      margin-bottom: -8px;
      border-width: 0px;
      transform: translateY(45px) scaleY(0.85);
      pointer-events: none;
    }

    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      font-size: 11.5px;
      color: var(--text-secondary);
      font-weight: 700;
    }

    /* Apple 위젯 스타일 영웅 카드 가로 스크롤 & 그리드 */
    .apple-hero-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 7px;
    }
    .apple-hero-card {
      padding: 8px 6px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
    }
    .apple-hero-card:active { transform: scale(0.94); }
    .apple-hero-card.deployed {
      background: rgba(10, 132, 255, 0.24);
      border-color: var(--apple-cyan);
      box-shadow: inset 0 0 12px rgba(90, 200, 250, 0.28);
    }
    .ahc-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 900;
      color: #fff;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.35);
    }
    .ahc-name { font-size: 11px; font-weight: 800; }
    .ahc-syn { font-size: 9px; color: var(--text-secondary); }
    .ahc-check {
      position: absolute;
      top: 5px;
      right: 5px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--apple-cyan);
      color: #000;
      font-size: 9px;
      font-weight: 900;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .apple-hero-card.deployed .ahc-check { display: flex; }

    /* ================= 모달 (뉴스 / 설정) ================= */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(4, 7, 15, 0.68);
      backdrop-filter: blur(16px);
      display: none;
      align-items: flex-end;
      justify-content: center;
    }
    .modal-backdrop.open { display: flex; }
    .sheet-card {
      width: 100%;
      max-width: 480px;
      max-height: 82dvh;
      background: var(--glass-heavy);
      border-top: 1px solid var(--glass-specular);
      border-radius: 28px 28px 0 0;
      padding: 20px 18px 28px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      overflow-y: auto;
    }
    .setting-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* 3D 유닛 오버레이 HUD */
    .unit-hud {
      position: absolute;
      transform: translate(-50%, -100%);
      width: 66px;
      pointer-events: none;
      transition: opacity 0.15s ease;
    }
    .unit-hud-name {
      font-size: 10px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 2px;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
      white-space: nowrap;
    }
    .hp-bar {
      width: 100%;
      height: 5px;
      background: rgba(15, 23, 42, 0.88);
      border-radius: 3px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.22);
      margin-bottom: 2px;
    }
    .hp-fill { height: 100%; background: linear-gradient(90deg, #30d158, #66e384); transition: width 0.12s ease; }
    .hp-fill.enemy { background: linear-gradient(90deg, #ff453a, #ff6961); }
    .mp-bar { width: 100%; height: 3.5px; background: rgba(15, 23, 42, 0.88); border-radius: 2px; overflow: hidden; }
    .mp-fill { height: 100%; background: linear-gradient(90deg, #5ac8fa, #0a84ff); transition: width 0.12s ease; }

    .float-dmg {
      position: absolute;
      transform: translate(-50%, -50%);
      font-weight: 900;
      font-size: 13.5px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
      pointer-events: none;
      animation: popFloat 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes popFloat {
      0% { opacity: 1; transform: translate(-50%, 0) scale(0.75); }
      25% { opacity: 1; transform: translate(-50%, -14px) scale(1.14); }
      100% { opacity: 0; transform: translate(-50%, -38px) scale(0.92); }
    }

    #toast-banner {
      position: fixed;
      top: 42%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.9);
      z-index: 45;
      padding: 14px 26px;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
      min-width: 240px;
    }
    #toast-banner.show {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body class="weather-DAY">

  <div id="canvas-container"></div>
  <div id="overlay-layer"></div>
  <div id="warp-tunnel"></div>

  <!-- 필살기 액션캠 레터박스 -->
  <div id="cinematic-bars">
    <div class="letterbox"><span class="cinematic-caption" id="cinematic-top-text">★ OVERDRIVE ACTIVATED ★</span></div>
    <div class="letterbox"><span class="cinematic-caption" id="cinematic-bot-text">TIME DILATION 0.18x</span></div>
  </div>

  <!-- ================= 1. 메인 화면 (Apple 프로필 위젯 + 3D 최애 영웅 쇼케이스) ================= -->
  <div id="title-screen">
    <!-- 상단 플레이어 프로필 카드 -->
    <div class="vision-glass profile-widget">
      <div class="profile-top">
        <div class="profile-left">
          <div class="avatar-ring" id="profile-avatar-ring">
            <span id="profile-avatar-char">한</span>
            <span class="lv-badge">Lv.28</span>
          </div>
          <div class="commander-info">
            <input type="text" id="commander-input" class="commander-name-input" value="한성우 사령관" maxlength="14" title="클릭하여 이름 변경" />
            <span class="commander-tier">💎 그랜드마스터 I · 에테르 기사단</span>
          </div>
        </div>
        <button class="vision-pill" id="btn-title-weather" title="배경 시간대/날씨 변경">☀️ 낮</button>
      </div>

      <div class="profile-stats-row">
        <div class="p-stat">
          <span class="p-stat-label">트로피</span>
          <span class="p-stat-val" style="color:var(--apple-gold);" id="profile-trophies">🏆 1,520</span>
        </div>
        <div class="p-stat">
          <span class="p-stat-label">매치 승률</span>
          <span class="p-stat-val" style="color:var(--apple-green);" id="profile-winrate">84.2%</span>
        </div>
        <div class="p-stat">
          <span class="p-stat-label">최애 영웅</span>
          <span class="p-stat-val" style="color:var(--apple-cyan);" id="profile-fav-name">한조</span>
        </div>
      </div>
    </div>

    <!-- 중앙 3D 최애 영웅 인터랙션 캡슐 (위쪽 3D 캐릭터가 시원하게 보임) -->
    <div class="vision-glass fav-hero-floating" id="btn-change-fav-quick">
      <span style="font-size:11.5px; font-weight:800; color:var(--apple-gold);">★ 대표 영웅</span>
      <span style="font-size:12.5px; font-weight:800;" id="floating-fav-label">한조 (Hanzo)</span>
      <span style="font-size:10.5px; color:var(--text-secondary);">↔ 드래그 회전 · 도감에서 변경 →</span>
    </div>

    <!-- 하단 메인 런처 독 -->
    <div class="vision-glass title-bottom-dock">
      <div class="brand-header">
        <div>
          <div style="font-size:10.5px; font-weight:800; color:var(--apple-cyan);">APPLE visionOS GLASS EDITION · v3.0</div>
          <div class="brand-logo">AETHER CHESS 3D</div>
        </div>
        <span style="font-size:11px; color:var(--text-secondary);">7 Heroes · Bo3 Arena</span>
      </div>

      <div class="news-pill-bar" id="btn-open-news-banner">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="background:var(--apple-blue); padding:2px 7px; border-radius:999px; font-size:10px; font-weight:800;">NEW v3.0</span>
          <span style="font-size:11.5px; font-weight:700; color:#e2e8f0;">신규 영웅 ‘블링크’ & 3D 스튜디오 도감 · 낮/밤 날씨 패치</span>
        </div>
        <span style="font-size:11px; color:var(--apple-cyan); font-weight:800;">보기 →</span>
      </div>

      <button class="vision-pill primary warp-btn" id="btn-warp-start">전장 입장 (WARP TO ARENA)</button>

      <div class="title-nav-grid">
        <button class="vision-pill" id="btn-title-codex">🧊 3D 영웅 도감</button>
        <button class="vision-pill" id="btn-title-news">📰 업데이트 뉴스</button>
        <button class="vision-pill" id="btn-title-settings">⚙️ 환경 설정</button>
      </div>
    </div>
  </div>

  <!-- ================= 2. 3D 인터랙티브 영웅 도감 화면 (3D STUDIO VIEW) ================= -->
  <div id="codex-screen">
    <!-- 상단 바 -->
    <div class="vision-glass codex-top-bar">
      <button class="vision-pill" id="btn-codex-back">← 돌아가기</button>
      <div style="text-align:center;">
        <div style="font-size:13px; font-weight:900;">3D HERO STUDIO</div>
        <div style="font-size:10px; color:var(--text-secondary);" id="codex-counter-text">1 / 7 HEROES</div>
      </div>
      <button class="vision-pill gold" id="btn-set-favorite">★ 최애 영웅 등록</button>
    </div>

    <!-- 중앙 3D 영웅 좌/우 넘기기 화살표 & 회전 힌트 -->
    <div class="codex-stage-controls">
      <button class="vision-pill arrow-circle" id="btn-codex-prev">◀</button>
      <span class="rotate-hint">👆 캐릭터를 좌우로 드래그해 360° 회전</span>
      <button class="vision-pill arrow-circle" id="btn-codex-next">▶</button>
    </div>

    <!-- 하단 상세 스펙 & 스킬 글래스 시트 -->
    <div class="vision-glass codex-info-sheet">
      <div class="hero-carousel-pills" id="codex-pills"></div>
      <div id="codex-detail-body"></div>
    </div>
  </div>

  <!-- ================= 3. 인게임 스마트폰 세로 쉘 (미니멀 캡슐 + 접이식 드로어) ================= -->
  <div id="mobile-shell">
    <!-- 상단 캡슐 HUD -->
    <div class="top-capsule-wrap interactive">
      <div class="vision-glass dynamic-capsule">
        <div class="dc-row-1">
          <div class="dc-left">
            <button class="mini-icon-btn" id="btn-home" title="메인 화면">🏠</button>
            <span style="font-size:12px; font-weight:900; color:var(--apple-cyan);" id="ui-stage-pill">STAGE 1</span>
            <span style="font-size:11px; font-weight:700; color:var(--apple-gold);" id="ui-phase-text">R1 · 배치</span>
          </div>
          <div class="dc-right">
            <button class="mini-icon-btn" id="btn-ingame-weather" title="날씨/시간대 전환">☀️</button>
            <button class="mini-icon-btn" id="btn-speed">1x</button>
            <button class="mini-icon-btn" id="btn-cam">시점</button>
            <button class="mini-icon-btn" id="btn-ingame-codex">🧊도감</button>
            <button class="mini-icon-btn" id="btn-ingame-settings">⚙️</button>
          </div>
        </div>

        <div class="dc-scoreboard">
          <div class="team-pips-wrap" style="color:var(--apple-cyan);">
            <span id="ui-commander-name">ALLY</span>
            <div class="pips" id="ally-pips"><div class="pip"></div><div class="pip"></div></div>
          </div>
          <span style="font-size:10px; font-weight:800; color:var(--text-secondary);">3판 2선승</span>
          <div class="team-pips-wrap" style="color:var(--apple-red);">
            <div class="pips" id="enemy-pips"><div class="pip"></div><div class="pip"></div></div>
            <span>ENEMY</span>
          </div>
        </div>
      </div>

      <div class="sub-pills-row">
        <div class="vision-glass stage-strip" id="stage-dots-box"></div>
        <div class="vision-glass synergy-strip" id="synergy-box"></div>
      </div>
    </div>

    <!-- 하단: 접이식 영웅 배치 드로어 + 항상 보이는 슬림 스킬/전투 바 -->
    <div class="bottom-hud-area interactive">
      <!-- [접이식] 아래로 스르륵 말려 들어가는 영웅 선택 창 -->
      <div class="vision-glass roster-drawer" id="roster-drawer">
        <div class="drawer-header">
          <span>영웅을 터치해 출전시키고 3×3 타일에서 드래그하세요</span>
          <span style="color:var(--apple-cyan);" id="ui-deploy-count">3 / 3명</span>
        </div>
        <div class="apple-hero-grid" id="roster-grid"></div>
      </div>

      <!-- [항상 표시] 슬림 컨트롤 독: 영웅창 토글 + 1회 필살기 원형 오브 + 전투 시작 -->
      <div class="vision-glass compact-action-bar">
        <button class="drawer-toggle-btn open" id="btn-toggle-drawer">
          <span id="drawer-toggle-label">영웅 선택 닫기 ▼</span>
        </button>

        <!-- 배치된 아군 영웅들의 1회 특수능력 아이콘 버튼만 깔끔하게 표시 -->
        <div class="quick-skill-orbs" id="quick-skill-orbs"></div>

        <button class="fight-pill-btn" id="btn-fight">전투 시작 ▶</button>
      </div>
    </div>
  </div>

  <!-- 중앙 알림 토스트 -->
  <div class="vision-glass" id="toast-banner">
    <div style="font-size:19px; font-weight:900;" id="toast-title">ROUND START</div>
    <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;" id="toast-sub">전투가 시작됩니다</div>
  </div>

  <!-- ================= 모달: 업데이트 뉴스 ================= -->
  <div id="news-modal" class="modal-backdrop interactive">
    <div class="sheet-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-size:17px; font-weight:900;">📰 업데이트 뉴스 (PATCH NOTES)</div>
          <div style="font-size:11px; color:var(--text-secondary);">매 버전 업데이트 기록</div>
        </div>
        <button class="vision-pill" data-close="news-modal">닫기 ✕</button>
      </div>
      <div id="news-list-container" style="display:flex; flex-direction:column; gap:10px;"></div>
    </div>
  </div>

  <!-- ================= 모달: 환경 설정 ================= -->
  <div id="settings-modal" class="modal-backdrop interactive">
    <div class="sheet-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-size:17px; font-weight:900;">⚙️ 환경 설정 (SETTINGS)</div>
          <div style="font-size:11px; color:var(--text-secondary);">연출 · 그래픽 · 사운드 · 스테이지 리셋</div>
        </div>
        <button class="vision-pill" data-close="settings-modal">닫기 ✕</button>
      </div>

      <div class="setting-item">
        <div>
          <div style="font-size:13px; font-weight:800;">🎬 필살기 줌인 & 슬로우 액션캠</div>
          <div style="font-size:11px; color:var(--text-secondary);">특수능력·궁극기 시전 시 0.18x 슬로우 연출</div>
        </div>
        <button class="vision-pill primary" id="set-action-cam">ON</button>
      </div>

      <div class="setting-item">
        <div>
          <div style="font-size:13px; font-weight:800;">🔊 Web Audio 효과음</div>
          <div style="font-size:11px; color:var(--text-secondary);">타격음, 차원 워프, 스킬 신디사이저 사운드</div>
        </div>
        <button class="vision-pill primary" id="set-sound">ON</button>
      </div>

      <div class="setting-item">
        <div>
          <div style="font-size:13px; font-weight:800;">🌸 자연 환경 파티클 (꽃잎·반딧불이)</div>
          <div style="font-size:11px; color:var(--text-secondary);">시간대에 따른 부유 입자 효과</div>
        </div>
        <button class="vision-pill primary" id="set-particles">ON</button>
      </div>

      <div class="setting-item">
        <div>
          <div style="font-size:13px; font-weight:800;">🔄 현재 스테이지 초기화</div>
          <div style="font-size:11px; color:var(--text-secondary);">현재 라운드 및 1회 특수능력 쿨타임 리셋</div>
        </div>
        <button class="vision-pill" id="btn-reset-in-settings">스테이지 리셋</button>
      </div>
    </div>
  </div>

  <script>
    /**************************************************************
     * 1. 패치노트 데이터 (v3.0 최신화)
     **************************************************************/
    const PATCH_NOTES = [
      {
        version: 'v3.0 [Apple visionOS & 3D 스튜디오 대규모 업데이트]',
        date: '2026.10.14',
        color: '#5ac8fa',
        items: [
          '🍎 [Apple visionOS UI] 고투명 스페큘러 글래스모피즘 및 다이나믹 캡슐 레이아웃 전면 적용',
          '🔽 [인게임 접이식 드로어] 영웅 배치 창이 아래로 깔끔하게 말려 들어가도록 개선 및 원형 1회 스킬 퀵 오브 도입',
          '⚡ [신규 영웅: 블링크(Blink)] 펄스 쌍권총 연사, 점멸 폭탄 부착(궁극기), 아군 시간 역행(1회 특수능력) 탑재',
          '🧊 [3D 인터랙티브 영웅 도감 & 최애 영웅] 3D 영웅을 좌우로 넘기며 360° 회전 감상하고 메인 화면 대표 영웅으로 등록 가능',
          '🌅 [동적 시간대 & 날씨 시스템] 낮(햇살) · 노을(황혼) · 밤(오로라 & 반딧불이) 실시간 환경 변화 추가'
        ]
      },
      {
        version: 'v2.0 [시네마틱 액션캠 & 자연 월드 패치]',
        date: '2026.10.12',
        color: '#30d158',
        items: [
          '🎬 필살기 발동 시 0.18배속 슬로우 모션 및 카메라 줌인 연출 추가',
          '🏞️ 에테르 강물, 폭포, 돌다리, 벚꽃·소나무 숲 자연 디오라마 배경 구축'
        ]
      }
    ];

    /**************************************************************
     * 2. Web Audio 사운드 신디사이저
     **************************************************************/
    const settings = { actionCam: true, sound: true, particles: true, shake: true };
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;

    function playTone(freq = 440, type = 'sine', duration = 0.12, vol = 0.08, endFreq = null) {
      if (!settings.sound) return;
      try {
        if (!audioCtx) audioCtx = new AudioCtx();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(endFreq || freq * 0.55, audioCtx.currentTime + duration);
        gain.gain.setValueAtTime(vol, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    /**************************************************************
     * 3. 캐릭터 7종 데이터 (신규 영웅 1번 '블링크' 포함!)
     **************************************************************/
    const CHARACTERS = {
      hanzo: {
        id: 'hanzo',
        name: '한조',
        fullName: '한조 (Hanzo)',
        role: '명궁 · 원거리',
        synergy: '타격대',
        color: 0x38bdf8,
        hex: '#38bdf8',
        hp: 780,
        atk: 96,
        range: 4.2,
        atkSpeed: 1.15,
        manaGain: 25,
